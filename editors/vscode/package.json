{
  "name": "attentry-design",
  "displayName": "Attentry Design",
  "description": "When you ask Claude Code to design something, Attentry Design makes sure the brief is asked, the options really differ, your choice is kept and the result has no errors. Checked on your machine, without AI. It never judges taste.",
  "version": "0.1.0",
  "publisher": "attentry",
  "license": "MIT",
  "private": true,
  "author": { "name": "Aarv Singh Chauhan" },
  "repository": { "type": "git", "url": "https://github.com/Aarv-1o/Attentry_design" },
  "engines": { "vscode": "^1.91.0" },
  "categories": ["AI", "Visualization"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "attentryDesign", "title": "Attentry Design", "icon": "resources/icon.svg" }]
    },
    "views": {
      "attentryDesign": [{ "type": "webview", "id": "attentryDesign.panel", "name": "Design" }]
    },
    "commands": [
      { "command": "attentryDesign.connect", "title": "Attentry Design: Connect Claude Code" }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0"
  }
}
